<!DOCTYPE html>
<html>
  <head>
    <title>GymLog</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">

    <meta property="og:title" content="GymLog">
    <meta property="og:description" content="筋トレを、もっと楽しく、続ける。">
    <meta property="og:image" content="<%= image_url("gymlog_ogp.png") %>">
    <meta property="og:type" content="website">
    
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body>
    <% if current_user.present? %>
      <span class="btn btn-primary"><%= current_user.name %></span>
      <%= button_to "ログアウト", logout_path, method: :post %>
    <% end %>
    <%= yield %>
  </body>
</html>
