<h1 class="page-title">🏋️‍♀️ Workout一覧 🏋️‍♀️</h1>
<%= month_calendar do |date| %>
  <%= link_to date.day, start_date: date %>
<% end %>

<div class="workout-list">
    <h2 class="workout-title">今日のWorkout</h2>

    <% @workouts.each do |workout| %>
        <p class="workout-item">
            <%= workout.exercise.name %><br>
            <%= workout.weight %>kg
            ×
            <%= workout.reps %>回
            ×
            <%= workout.sets %>セット<br>
            <% if workout.memo.present? %>
                今日のメモ：<%= workout.memo %>
            <% end %>
        </p>
    <% end %>

    <% if flash[:notice] %>
        <div class="alert alert-success"><%= notice %></div>
    <% end %>

    <%= link_to "＋ Workoutを追加", 
    new_workout_path(date: params[:start_date]),
    class: "add-workout-button" %>
</div>
