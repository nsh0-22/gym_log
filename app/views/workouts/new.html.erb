<h1>Workout登録</h1>

<%= form_with(model: @workout, local: true) do |form| %>
    <% if @workout.errors.any? %>
    <div class="error-alert">
        <ul>
            <% @workout.errors.full_messages.each do |message| %>
                <li class='error-message'><%= message %></li>
            <% end %>
        </ul>
    </div>
    <% end %>
        <p>
            種目<br>
            <%= form.collection_select :exercise_id, @exercises, :id, :name, { prompt: "種目を選択してください" } %>
        </p>
        <p>
            重量（kg）<br>
            <%= form.number_field :weight %>
        </p>
        <p>
            回数（回）<br>
            <%= form.number_field :reps %>
        </p>
        <p>
            セット数（回）<br>
            <%= form.number_field :sets %>
        </p>
        <%= form.hidden_field :date, value: params[:date] %>

        <%= form.submit "登録" %>
<% end %>