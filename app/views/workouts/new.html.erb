<div class="workout-form" id="workout-form">
<h1>Workout登録</h1>

<%= form_with(model: @workout) do |form| %>
        <p>
            種目<br>
            <%= form.collection_select :exercise_id, @exercises, :id, :name, { prompt: "種目を選択してください" }, class: "put-event" %>
        </p>
        <p>
            重量（kg）<br>
            <%= form.number_field :weight, class: "put-weight" %>
        </p>
        <p>
            回数（回）<br>
            <%= form.number_field :reps, class: "put-reps" %>
        </p>
        <p>
            セット数（回）<br>
            <%= form.number_field :sets, class: "put-sets" %>
        </p>
        <p>
            メモ<br>
            <%= form.text_area :memo, class: "put-text"  %>
        </p>
        <%= form.hidden_field :date, value: params[:date] %>

        <%= form.submit "登録" %>
<% end %>
</div>

<div id="error-area"></div>